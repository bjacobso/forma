{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsdown.config.ts", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "@formalang/host#test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/conformance/modules/**",
        "$TURBO_ROOT$/conformance/compile-time-modules/**"
      ]
    },
    "pack:check": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
