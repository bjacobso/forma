{
  "name": "forma-lang",
  "version": "0.1.0",
  "description": "Forma is a typed, homoiconic Lisp for building domain-specific languages and portable artifacts.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/ci-install-registry.mjs --lockfile-only",
    "release:check": "pnpm check && pnpm pack:check",
    "release:publish": "changeset publish",
    "pack:check": "node scripts/check-packages.mjs",
    "foldworks:link": "node scripts/foldworks-link.mjs",
    "foldworks:unlink": "node scripts/foldworks-link.mjs --unlink",
    "build": "pnpm build:js",
    "build:js": "turbo run build --filter=@formalang/ts --filter=@formalang/host --filter=@formalang/editor --filter=@formalang/language-server --filter=@formalang/workbench --filter=@formalang/workbench-app --filter=@formalang/website",
    "dev": "pnpm --filter @formalang/website dev",
    "workbench": "pnpm --filter @formalang/ts --filter @formalang/host --filter @formalang/workbench build && pnpm --filter @formalang/workbench-app dev",
    "docs:build": "vitepress build docs && node scripts/llms.mjs --generate",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "test": "pnpm test:js",
    "test:js": "turbo run test --filter=@formalang/ts --filter=@formalang/host --filter=@formalang/editor --filter=@formalang/language-server --filter=@formalang/workbench --filter=@formalang/workbench-app --filter=@formalang/website && pnpm surfaces:test",
    "surfaces": "pnpm --filter @formalang/ts build && pnpm --filter @formalang/host build && node scripts/check-surfaces.mjs",
    "surfaces:test": "node --test scripts/surfaces/*.test.mjs && pnpm surfaces",
    "test:visual": "pnpm --filter @formalang/website test:visual",
    "typecheck": "tsc --noEmit -p tsconfig.alchemy.json && tsc --noEmit -p conformance/effect-typescript/tsconfig.json && turbo run typecheck --filter=@formalang/ts --filter=@formalang/host --filter=@formalang/editor --filter=@formalang/language-server --filter=@formalang/workbench --filter=@formalang/workbench-app --filter=@formalang/website",
    "check": "pnpm check:branding && pnpm check:changesets && pnpm typecheck && pnpm test:js && pnpm docs:build",
    "check:branding": "bash scripts/check-branding.sh",
    "check:changesets": "changeset status",
    "check:llms": "node scripts/llms.mjs",
    "website:build": "pnpm docs:build && turbo run build --filter=@formalang/website --filter=@formalang/workbench-app && node scripts/assemble-website.mjs && node scripts/llms.mjs dist-site",
    "website:plan": "alchemy plan --stage prod",
    "website:deploy": "alchemy deploy --stage prod",
    "website:dry-run": "pnpm --filter @formalang/website exec wrangler deploy --dry-run",
    "test:e2e:workbench": "pnpm --filter @formalang/workbench-app test:e2e",
    "test:site": "pnpm --filter @formalang/website test:site",
    "format": "turbo run build --filter=@formalang/host && node scripts/format.mjs",
    "format:check": "turbo run build --filter=@formalang/host && node scripts/format.mjs --check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@effect/platform-node": "4.0.3",
    "@types/node": "^25.9.1",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.3",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "tsdown": "^0.22.2",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "5.0.4",
    "foldkit": "0.168.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
