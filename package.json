{
  "name": "forma-lang",
  "version": "0.1.0",
  "description": "Forma is a typed, homoiconic Lisp for building domain-specific languages and portable artifacts.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:check": "pnpm check && pnpm build:ocaml && pnpm --filter @formalang/language-server build:release && pnpm pack:check",
    "release:publish": "changeset publish",
    "pack:check": "node scripts/check-packages.mjs",
    "build": "pnpm build:js && pnpm build:ocaml",
    "build:js": "turbo run build --filter=@formalang/ts --filter=@formalang/host --filter=@formalang/editor --filter=@formalang/language-server --filter=@formalang/website",
    "build:ocaml": "pnpm --filter @formalang/ocaml build",
    "dev": "pnpm --filter @formalang/website dev",
    "test": "pnpm test:js",
    "test:js": "turbo run test --filter=@formalang/ts --filter=@formalang/host --filter=@formalang/editor --filter=@formalang/language-server --filter=@formalang/website",
    "test:ocaml": "pnpm build:ocaml && turbo run build --filter=@formalang/language-server && pnpm --filter @formalang/ocaml test:ocaml && pnpm --filter @formalang/language-server test:parity",
    "test:all": "pnpm test:js && pnpm test:ocaml",
    "test:visual": "pnpm --filter @formalang/website test:visual",
    "typecheck": "tsc --noEmit -p tsconfig.alchemy.json && turbo run typecheck --filter=@formalang/ts --filter=@formalang/host --filter=@formalang/editor --filter=@formalang/language-server --filter=@formalang/website",
    "check": "pnpm check:branding && pnpm typecheck && pnpm test:js",
    "check:branding": "bash scripts/check-branding.sh",
    "website:build": "turbo run build --filter=@formalang/website",
    "website:plan": "alchemy plan --stage prod",
    "website:deploy": "alchemy deploy --stage prod",
    "website:dry-run": "pnpm --filter @formalang/website exec wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@effect/platform-node": "4.0.0-rc.112",
    "@types/node": "^25.9.1",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112",
    "tsdown": "^0.22.2",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
