(export Book unread-titles total-pages long-titles)
(type Book {:title String :pages Int :read Bool})
(: unread-titles (-> (List Book) (List String)))
(define unread-titles [books] (map (fn [b] b.title) (filter (fn [b] (if b.read false true)) books)))
(: add-pages (-> Int Book Int))
(define add-pages [n b] (+ n b.pages))
(: total-pages (-> (List Book) Int))
(define total-pages [books] (reduce add-pages 0 books))
(: long-titles (-> (List Book) Int (List String)))
(define long-titles [books threshold] (map (fn [b] b.title) (filter (fn [b] (>= b.pages threshold)) books)))
