(import "./types.lisp" [Role Event Summary])
(export identity same required summarize amounts)
(: identity (-> a a))
(define identity [x] x)
(: same (-> a a Bool))
(define same [a b] (= a b))
(: required (-> Int (List Role)))
(define required [n] (if (> n 250000) [:manager :finance] (if (> n 7500) [:manager] [])))
(: amount (-> Event Int))
(define amount [e] (match e (Event.Charge c) c.cents (Event.Refund r) (- 0 r.cents) Event.Void 0))
(: amounts (-> (List Event) (List Int)))
(define amounts [events] (map amount events))
(: charge? (-> Event Bool))
(define charge? [e] (match e (Event.Charge _) true (Event.Refund _) false Event.Void false))
(: charge-role (-> Event Role))
(define charge-role [e] (match e (Event.Charge c) c.role (Event.Refund _) :auditor Event.Void :auditor))
(: add-amount (-> Int Event Int))
(define add-amount [a e] (+ a (amount e)))
(: summarize (-> (List Event) Summary))
(define summarize [events]
 {:net (reduce add-amount 0 events)
  :charges (count (filter charge? events))
  :roles (map charge-role (filter charge? events))})
