{
  "name": "@formalang/host",
  "version": "0.4.0",
  "description": "Forma host: the language-host ABI, JSON CLI, and session facade over the TypeScript engine (@formalang/ts).",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/bjacobso/forma.git", "directory": "packages/host" },
  "homepage": "https://forma-lang.com",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./default-host": {
      "types": "./dist/default-host.d.mts",
      "import": "./dist/default-host.mjs"
    },
    "./editor": {
      "types": "./dist/editor.d.mts",
      "import": "./dist/editor.mjs"
    },
    "./ts-host": {
      "types": "./dist/ts-host.d.mts",
      "import": "./dist/ts-host.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./json-abi": {
      "types": "./dist/json-abi.d.mts",
      "import": "./dist/json-abi.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:check": "node ../../scripts/pnpm-pack-check.mjs"
  },
  "dependencies": {
    "@formalang/ts": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.4"
  },
  "bin": {
    "forma": "./dist/cli.mjs"
  }
}
