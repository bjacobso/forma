{
  "name": "@formalang/host",
  "version": "0.2.0",
  "description": "Forma host: the shared ABI facade bridging the TypeScript (@formalang/ts) and OCaml (@formalang/ocaml) language engines.",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/bjacobso/forma.git", "directory": "packages/host" },
  "homepage": "https://forma-lang.com",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./default-host": {
      "types": "./dist/default-host.d.mts",
      "import": "./dist/default-host.mjs"
    },
    "./editor": {
      "types": "./dist/editor.d.mts",
      "import": "./dist/editor.mjs"
    },
    "./js-ocaml-host": {
      "types": "./dist/js-ocaml-host.d.mts",
      "import": "./dist/js-ocaml-host.mjs"
    },
    "./ocaml-host": {
      "types": "./dist/ocaml-host.d.mts",
      "import": "./dist/ocaml-host.mjs"
    },
    "./ts-host": {
      "types": "./dist/ts-host.d.mts",
      "import": "./dist/ts-host.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:check": "node ../../scripts/pnpm-pack-check.mjs"
  },
  "dependencies": {
    "@formalang/ts": "workspace:*",
    "effect": "^3.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
