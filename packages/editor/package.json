{
  "name": "@formalang/editor",
  "private": true,
  "version": "0.3.0",
  "description": "Forma editor: CodeMirror + React editor integration for the Forma language (via @formalang/host).",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/bjacobso/forma.git", "directory": "packages/editor" },
  "homepage": "https://forma-lang.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analysis-host": {
      "types": "./dist/analysis-host.d.ts",
      "import": "./dist/analysis-host.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror/index.d.ts",
      "import": "./dist/codemirror/index.js",
      "default": "./dist/codemirror/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "lezer-generator src/grammar/lisp.grammar -o src/grammar/parser.generated.ts && node -e \"const fs=require('fs'); for(const f of ['src/grammar/parser.generated.ts','src/grammar/parser.generated.terms.ts']){const c=fs.readFileSync(f,'utf8'); fs.writeFileSync(f,'// @ts-nocheck\\n'+c)}\"",
    "build": "pnpm run generate && tsdown",
    "test": "pnpm run generate && vitest --run",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "clean": "rm -rf dist src/grammar/parser.generated.ts src/grammar/parser.generated.terms.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@formalang/host": "workspace:*",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2"
  },
  "devDependencies": {
    "@lezer/generator": "^1.7.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "effect": "4.1.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "effect": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
