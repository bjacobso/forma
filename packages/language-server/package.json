{
  "name": "@formalang/language-server",
  "version": "0.1.0",
  "description": "Language Server Protocol implementation for Forma, backed by the OCaml engine.",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/bjacobso/forma.git", "directory": "packages/language-server" },
  "homepage": "https://forma-lang.com",
  "bin": {
    "forma-language-server": "./bin/forma-language-server.mjs"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build:release": "pnpm build && node scripts/prepare-release.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "test:parity": "vitest --run test/parity.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@formalang/host": "workspace:*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
