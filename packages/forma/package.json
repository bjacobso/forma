{
  "name": "@forma-language/forma",
  "version": "0.6.0",
  "description": "Forma: a pre-alpha typed Lisp, language host, editor adapters and language server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjacobso/forma.git",
    "directory": "packages/forma"
  },
  "homepage": "https://forma-lang.com",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./reader": {
      "types": "./dist/reader.d.mts",
      "import": "./dist/reader.mjs"
    },
    "./engine": {
      "types": "./dist/engine.d.mts",
      "import": "./dist/engine.mjs"
    },
    "./mechanics": {
      "types": "./dist/mechanics.d.mts",
      "import": "./dist/mechanics.mjs"
    },
    "./expander": {
      "types": "./dist/expander.d.mts",
      "import": "./dist/expander.mjs"
    },
    "./type": {
      "types": "./dist/type.d.mts",
      "import": "./dist/type.mjs"
    },
    "./diagnostic": {
      "types": "./dist/diagnostic.d.mts",
      "import": "./dist/diagnostic.mjs"
    },
    "./formatter": {
      "types": "./dist/formatter.d.mts",
