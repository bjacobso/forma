    "./rpc": {
      "types": "./dist/rpc.d.mts",
      "import": "./dist/rpc.mjs"
    },
    "./descriptor": {
      "types": "./dist/descriptor.d.mts",
      "import": "./dist/descriptor.mjs"
    },
    "./preludes": {
      "types": "./dist/preludes.d.mts",
      "import": "./dist/preludes.mjs"
    },
    "./modules": {
      "types": "./dist/modules.d.mts",
      "import": "./dist/modules.mjs"
    },
    "./node": {
      "node": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs"
      }
    },
    "./elm": {
      "types": "./dist/elm.d.mts",
      "import": "./dist/elm.mjs"
    },
    "./email": {
      "types": "./dist/email.d.mts",
      "import": "./dist/email.mjs"
