    "./host": {
      "types": "./dist/host.d.mts",
      "import": "./dist/host.mjs"
    },
    "./host/types": {
      "types": "./dist/host/types.d.mts",
      "import": "./dist/host/types.mjs"
    },
    "./host/json-abi": {
      "types": "./dist/host/json-abi.d.mts",
      "import": "./dist/host/json-abi.mjs"
    },
    "./editor": {
      "types": "./dist/editor.d.mts",
      "import": "./dist/editor.mjs"
    },
    "./editor/codemirror": {
      "types": "./dist/editor/codemirror.d.mts",
      "import": "./dist/editor/codemirror.mjs"
    },
    "./editor/react": {
      "types": "./dist/editor/react.d.mts",
      "import": "./dist/editor/react.mjs"
    },
    "./language-server": {
      "node": {
        "types": "./dist/language-server.d.mts",
        "import": "./dist/language-server.mjs"
      }
    }
  },
  "bin": {
    "forma": "./dist/cli.mjs",
    "forma-language-server": "./dist/forma-language-server.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/executable.mjs",
    "test": "node --test ../../scripts/optional-dependencies.test.mjs && node ../../scripts/check-distribution.mjs",
    "typecheck": "node ../../scripts/check-distribution.mjs"
  },
  "peerDependencies": {
    "effect": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@codemirror/autocomplete": "^6.18.6",
