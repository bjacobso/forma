{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forma-website",
  "compatibility_date": "2026-06-10",
  "main": "./src/worker.ts",
  "r2_buckets": [{ "binding": "PLAYGROUNDS", "bucket_name": "forma-playgrounds" }],
  "ratelimits": [{ "name": "PLAYGROUND_WRITES", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../dist-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/feed.xml",
      "/sitemap.xml",
      "/robots.txt",
      "/playground",
      "/playground/*",
      "/about",
      "/demo",
      "/demo/*",
      "/workbench/demo",
      "/workbench/demo/"
    ]
  }
}
