{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forma-website",
  "compatibility_date": "2026-06-10",
  "main": "./src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "../../dist-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/playground",
      "/playground/*",
      "/about",
      "/demo",
      "/demo/*"
    ]
  }
}
