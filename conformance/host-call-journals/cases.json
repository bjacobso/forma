    {
      "id": "sequential-calls",
      "sourceId": "sequential.lisp",
      "source": "(let [cfg (read-kv \"config\")]\n  (write-kv \"snapshot\" {:count 2 :ratio 2.5 \"raw\" [1 2]})\n  cfg)",
      "journalFile": "sequential-calls.jsonl",
      "resume": [
        {
          "ok": true,
          "value": {
            "kind": "map",
            "entries": [
              { "key": { "kind": "keyword", "value": ":version" }, "value": { "kind": "int", "value": 3 } },
              { "key": { "kind": "string", "value": "rate" }, "value": { "kind": "float", "value": 1.5 } },
              { "key": { "kind": "symbol", "value": "tags" }, "value": { "kind": "vector", "items": [{ "kind": "string", "value": "a" }, { "kind": "string", "value": "b" }] } }
            ]
          }
        },
        {
          "ok": true,
          "value": { "kind": "bool", "value": true }
        }
      ],
      "expected": {
        "status": "completed",
        "printed": "{:version 3 \"rate\" 1.5 tags [\"a\" \"b\"]}"
      }
    },
    {
      "id": "failed-call",
      "sourceId": "failed.lisp",
      "source": "(read-kv \"secret.key\")",
      "journalFile": "failed-call.jsonl",
