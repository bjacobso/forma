;; Implicit Option filling and field access work for an imported record type
;; exactly as they do for a type declared in the same module.
(import "./shapes.forma" [Review])
(: scored Review)
(define scored {:vendor "Acme" :score 7})
(: pending Review)
(define pending {:vendor "Beacon"})
(define score-of [review]
  (match review.score
    (Some score) score
    None -1))
[(score-of scored) (score-of pending) (count scored.vendor)]
