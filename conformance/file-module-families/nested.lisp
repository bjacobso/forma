(export layout)
(define suffix "!")
(define label/check [{:keys [label]}] (if (= label "bad") [{:severity :error :code "E_LABEL" :message "Invalid label" :at [:label]}] []))
(define label/ir [label] (str label suffix))
(type LeafIR {:label String})
(type leaves (Union LeafIR))
(form (leaves/text label) :types {:label String} :check label/check :ir LeafIR {:label (label/ir label)})
(type PanelIR {:children (List LeafIR)})
(type panels (Union PanelIR))
(form (panels/panel child ...) :types {:child (List leaves)} :ir PanelIR {:children child})
(type LayoutIR {:name Symbol :children (List PanelIR)})
(form (layout name child ...) :types {:name (Declares LayoutDef) :child (List panels)} :ir LayoutIR {:name name :children child})
