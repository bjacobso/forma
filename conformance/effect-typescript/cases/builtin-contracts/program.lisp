(: reversed (-> (List Int) (List Int)))
(define reversed [xs] (reverse xs))
(: root (-> Float Float))
(define root [x] (sqrt x))
(: appended (-> (List Int) Int (List Int)))
(define appended [xs x] (conj xs x))
(: concatenated (-> (List Int) (List Int) (List Int)))
(define concatenated [xs ys] (concat xs ys))
(: collected (-> (List Int) (List Int) (List Int)))
(define collected [init xs] (reduce (fn [acc item] (conj acc item)) init xs))
(: quotient (-> Int Int Int))
(define quotient [x y] (quot x y))
