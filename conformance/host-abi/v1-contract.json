{
  "contractVersion": "1.0.0",
  "hostAbiVersion": "0.2.0",
  "journalFormat": "forma-journal/v1",
  "requiredOperations": [
    "version",
    "openSession",
    "configureSession",
    "loadSource",
    "loadSourceBundle",
    "closeSession",
    "resetSession",
    "describe",
    "sessionInfo",
    "parse",
    "parseAst",
    "parseSummary",
    "incrementalSummary",
    "expand",
    "typecheck",
    "typecheckCore",
    "typecheckCoreTyped",
    "lowerCore",
    "evaluate",
    "observe",
    "evaluateInSession",
    "checkedRun",
    "replSubmit",
    "emit",
    "emitMany",
    "artifactSummary",
    "emitBackends",
    "callValue",
    "resumeHostCall",
    "abortEvaluation",
    "projectValue",
    "releaseValue",
    "moduleGraph",
    "linkEffectModules",
    "identifySyntax",
    "symbolIndex",
    "findReferences",
    "applyEditScript",
    "describeNodes",
    "editScriptSchema",
    "sourceToOutline",
    "outlineToSource",
    "formSlots",
    "analyzeEditor"
  ],
  "journalDefinitions": [
    "JournalHeader",
    "JournalValue",
    "JournalEntry",
    "HostCallJournal"
  ],
  "checkedRunLimits": [
    "steps",
    "hostCalls",
    "timeoutMs",
    "maxExpansionSteps",
    "maxResultBytes"
  ],
  "manifestFields": {
    "root": ["sources", "preludes", "capabilities"],
    "digest": ["sourceId", "sha256"],
    "capability": ["name", "effect", "signature", "purity"]
  },
  "journalDiagnostics": [
    "journal/invalid",
    "journal/unknown-builtin",
    "journal/program-mismatch",
    "journal/diverged",
    "journal/exhausted",
    "journal/redacted",
    "journal/unused-entries"
  ],
  "budgetDiagnostics": [
    "limit/steps",
    "limit/host-calls",
    "limit/time",
    "limit/expansion",
    "limit/result-size"
  ]
}
